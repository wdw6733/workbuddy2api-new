# WorkBuddy Gateway —— 带无头浏览器的镜像（可选）
#
# 用途：给「签到强制 Cloudflare Turnstile」的公益站（如幻城网安 api.hcnsec.cn）
# 自动签到。Turnstile 的 token 只能由浏览器里的 JS 算出来，纯 HTTP 拿不到。
#
# 这里用的浏览器是 cloakbrowser（打过指纹补丁的 Chromium）而不是 playwright 自带的
# 那个 —— 实测普通 Chromium 会被 Cloudflare 识破（challenge-platform 的 /pat 返回
# 401，getResponse() 永远为空），cloakbrowser 能在幻城网安上铸出 794 字符的 token，
# 且站点接受它。
#
# 代价：镜像约 1.2GB（Python 基础层 + 系统库 + 预下载的浏览器）。所以它单独打
# :browser 标签，主镜像（alpine，约 63MB）保持精简；用哪个由 compose 的 image 决定。
#
# 主镜像（python:3.11-alpine）装不了 Chromium（musl），所以这里用 slim。
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8788 \
    API_KEY= \
    TZ=Asia/Shanghai \
    CLOAKBROWSER_CACHE_DIR=/app/.local/cloakbrowser

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata ca-certificates \
 && cp /usr/share/zoneinfo/${TZ} /etc/localtime \
 && echo "${TZ}" > /etc/timezone \
 && rm -rf /var/lib/apt/lists/*

# cloakbrowser 依赖 playwright 的 Python 包；浏览器二进制由 ensure_binary() 自己下。
# 先装包，再用 playwright 的 install-deps 把 Chromium 需要的系统库补齐
# （它按 Debian 版本维护，比手写列表可靠），最后把浏览器预下载进镜像 ——
# 否则第一次签到才下 500MB，国内网络经常失败。
RUN pip install --no-cache-dir cloakbrowser==0.5.7 \
 && python -m playwright install-deps chromium \
 && mkdir -p /app/.local/cloakbrowser \
 && python -c "from cloakbrowser import ensure_binary; print('browser:', ensure_binary())" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /root/.cache

# 应用本体（零外部依赖，直接跑源码）
COPY wb_*.py dashboard.html ./

RUN mkdir -p /app/accounts /app/usage

# accounts 里会多一个 browser/ 目录：每个站点一个持久化 profile，
# Cloudflare cookie 与站点会话留在里面，跨天复用，不用每天重新登录。
VOLUME ["/app/accounts", "/app/usage"]

EXPOSE 8788

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8788'), timeout=3)" || exit 1

CMD ["python", "wb_proxy.py", "--host", "0.0.0.0", "--lan"]
